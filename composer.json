{
    "name": "vahidkaargar/zohal-php-sdk",
    "description": "PHP SDK for the Zohal inquiry, banking, and biometric API",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/vahidkaargar/zohal-php-sdk",
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "illuminate/container": "^9.0|^10.0|^11.0|^12.0",
        "illuminate/config": "^9.0|^10.0|^11.0|^12.0",
        "vlucas/phpdotenv": "^5.5"
    },
    "autoload": {
        "psr-4": {
            "Zohal\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zohal\\Sdk\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Zohal\\Sdk\\Laravel\\ZohalServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "platform": {
            "php": "8.1.99"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
